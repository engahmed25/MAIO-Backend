  "item": [
    {
      "name": "Patient Profile",
      "description": "Authenticated patient profile management.",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/patients/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "me"
              ]
            },
            "header": [],
            "description": "Get the authenticated patient's own profile. Requires patient role.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response success flag\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success', true);",
                  "});",
                  "",
                  "pm.test(\"Response has patient profile fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('firstName');",
                  "    pm.expect(jsonData.data).to.have.property('lastName');",
                  "    pm.expect(jsonData.data).to.have.property('email');",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('patientId', jsonData.data._id);",
                  "}",
                  ""
                ]
              }
            }
          ]
        },
        {
