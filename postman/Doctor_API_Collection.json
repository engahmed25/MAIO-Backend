							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success property\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success');",
									"    pm.expect(jsonData.success).to.eql(true);",
									"});",
									"",
									"pm.test(\"Profile updated successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('message');",
									"    pm.expect(jsonData.message).to.include('updated');",
									"});",
									"",
									"pm.test(\"Updated data is returned\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('firstName');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"Ahmed\",\n    \"lastName\": \"Mohamed\",\n    \"bio\": \"Experienced cardiologist with 15 years of practice. Specialized in heart disease treatment and prevention.\",\n    \"ratePerSession\": 250,\n    \"clinicAddress\": \"123 Medical Street, Cairo, Egypt\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/doctors/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"doctors",
								"me"
							]
						},
						"description": "Update doctor profile. Only allowed fields can be updated. Verification documents must be uploaded separately."
					},
					"response": []
				},
				{
					"name": "Upload Verification Documents",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success property\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success');",
									"    pm.expect(jsonData.success).to.eql(true);",
									"});",
									"",
									"pm.test(\"Status change notification present\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include('pending');",
									"});",
									"",
									"pm.test(\"Documents uploaded successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('phdCertificate');",
									"});",
									"",
									"// Save status for verification",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set('userStatus', jsonData.data.status);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "phdCertificate",
									"type": "file",
									"src": [],
									"description": "PDF or DOC file (max 5MB)"
								},
								{
									"key": "medicalLicense",
									"type": "file",
									"src": [],
									"description": "PDF or DOC file (max 5MB)"
								},
								{
									"key": "idProof",
									"type": "file",
									"src": [],
									"description": "JPG, PNG, or PDF file (max 5MB)"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/doctors/me/documents",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"doctors",
								"me",
								"documents"
							]
						},
						"description": "Upload verification documents (phdCertificate, medicalLicense, idProof). At least one file is required. This will change user status to 'pending' for re-verification."
					},
					"response": []
				}
