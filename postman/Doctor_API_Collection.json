		{
			"name": "Doctor Search",
			"item": [
				{
					"name": "Search - No Filters",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success property\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success');",
									"    pm.expect(jsonData.success).to.eql(true);",
									"});",
									"",
									"pm.test(\"Response has data with doctors array\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('doctors');",
									"    pm.expect(jsonData.data.doctors).to.be.an('array');",
									"});",
									"",
									"pm.test(\"Response has pagination metadata\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('pagination');",
									"    pm.expect(jsonData.data.pagination).to.have.property('page');",
									"    pm.expect(jsonData.data.pagination).to.have.property('limit');",
									"    pm.expect(jsonData.data.pagination).to.have.property('total');",
									"    pm.expect(jsonData.data.pagination).to.have.property('pages');",
									"});",
									"",
									"pm.test(\"Pagination values are valid\", function () {",
									"    var jsonData = pm.response.json();",
									"    var pagination = jsonData.data.pagination;",
									"    pm.expect(pagination.page).to.be.at.least(1);",
									"    pm.expect(pagination.limit).to.be.at.least(1);",
									"    pm.expect(pagination.total).to.be.at.least(0);",
									"    pm.expect(pagination.pages).to.be.at.least(0);",
									"});",
									"",
									"pm.test(\"All doctors have required fields\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data.doctors.length > 0) {",
									"        var doctor = jsonData.data.doctors[0];",
									"        pm.expect(doctor).to.have.property('_id');",
									"        pm.expect(doctor).to.have.property('firstName');",
									"        pm.expect(doctor).to.have.property('specialization');",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
