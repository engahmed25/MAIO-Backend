	"item": [
		{
			"name": "Doctor Profile",
			"item": [
				{
					"name": "Get Own Profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success property\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success');",
									"    pm.expect(jsonData.success).to.eql(true);",
									"});",
									"",
									"pm.test(\"Response has data with profile fields\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('firstName');",
									"    pm.expect(jsonData.data).to.have.property('lastName');",
									"    pm.expect(jsonData.data).to.have.property('specialization');",
									"});",
									"",
									"// Save doctorId for other requests",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set('doctorId', jsonData.data._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/doctors/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"doctors",
								"me"
							]
						},
						"description": "Get the authenticated doctor's own profile. Requires doctor role."
					},
					"response": []
				},
