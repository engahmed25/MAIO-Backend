{
  "info": {
    "_postman_id": "admin-api-collection-001",
    "name": "Admin API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requests and smoke tests for /api/admin endpoints. Uses {{baseUrl}} and {{token}} environment variables."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Admin authentication flows",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin1@example.com\",\n  \"password\": \"Admin123\",\n  \"firstName\": \"Super\",\n  \"lastName\": \"Admin\",\n  \"phoneNumber\": \"01012345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "register"
              ]
            },
            "description": "Creates a new admin account with approved status."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Success flag present\", () => pm.expect(json.success).to.eql(true));",
                  "pm.test(\"Has admin identifiers\", () => {",
                  "    pm.expect(json.data).to.have.property('userId');",
                  "    pm.expect(json.data).to.have.property('adminId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin1@example.com\",\n  \"password\": \"Admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "login"
              ]
            },
            "description": "Logs in an admin and saves accessToken to the environment."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Token fields exist\", () => {",
                  "    pm.expect(json).to.have.property('accessToken');",
                  "    pm.expect(json).to.have.property('refreshToken');",
                  "});",
                  "pm.environment.set('token', json.accessToken);",
                  "pm.environment.set('adminUserId', json.data && (json.data._id || json.data.userId));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Dashboard",
      "description": "Admin dashboard metrics",
      "item": [
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "dashboard",
                "metrics"
              ]
            },
            "description": "Returns counts of users, roles, verification statuses, activity, and appointment totals."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Totals exist\", () => {",
                  "    pm.expect(json.data).to.have.property('totals');",
                  "    pm.expect(json.data.totals).to.have.property('users');",
                  "});",
                  "pm.test(\"Verification breakdown present\", () => {",
                  "    pm.expect(json.data).to.have.property('verification');",
                  "    pm.expect(json.data.verification).to.have.property('approved');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "description": "User listing and retrieval",
      "item": [
        {
          "name": "List Users (filters + pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?page=1&limit=10&role=doctor&status=approved&verificationStatus=approved&search=john&sortBy=lastLogin&sortOrder=desc&includeDeleted=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "role",
                  "value": "doctor"
                },
                {
                  "key": "status",
                  "value": "approved"
                },
                {
                  "key": "verificationStatus",
                  "value": "approved"
                },
                {
                  "key": "search",
                  "value": "john"
                },
                {
                  "key": "sortBy",
                  "value": "lastLogin"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                },
                {
                  "key": "includeDeleted",
                  "value": "false"
                }
              ]
            },
            "description": "Lists users with pagination, role/status filters, verification filters, search, and sorting."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has pagination\", () => {",
                  "    pm.expect(json).to.have.property('pagination');",
                  "    pm.expect(json.pagination).to.have.property('page');",
                  "    pm.expect(json.pagination).to.have.property('limit');",
                  "});",
                  "pm.test(\"Data is array\", () => pm.expect(Array.isArray(json.data)).to.eql(true));",
                  "if (json.data && json.data.length) {",
                  "    pm.environment.set('userId', json.data[0]._id || json.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Pending Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/pending?page=1&limit=5&role=doctor&includeDeleted=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "pending"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "role",
                  "value": "doctor"
                },
                {
                  "key": "includeDeleted",
                  "value": "false"
                }
              ]
            },
            "description": "Lists users whose account and verification statuses are pending."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"All users are pending\", () => {",
                  "    if (Array.isArray(json.data)) {",
                  "        json.data.forEach(u => pm.expect(['pending', null]).to.include(u.verificationStatus));",
                  "    }",
                  "});",
                  "if (json.data && json.data.length) {",
                  "    pm.environment.set('pendingUserId', json.data[0]._id || json.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Retrieves a single user with linked profile and profileCompletion."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has profileCompletion\", () => pm.expect(json.data).to.have.property('profileCompletion'));",
                  "pm.test(\"Includes profile object\", () => {",
                  "    pm.expect(json.data).to.have.property('doctorProfile');",
                  "    pm.expect(json.data).to.have.property('patientProfile');",
                  "    pm.expect(json.data).to.have.property('adminProfile');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Verification & Status",
      "description": "Admin actions to update user status and verification",
      "item": [
        {
          "name": "Update User Status (approve/activate/suspend)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{userId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "{{userId}}",
                "status"
              ]
            },
            "description": "Updates user status to pending, approved, active, or suspended."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status field matches\", () => pm.expect(json.data.status).to.exist);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Approve Verification",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verificationStatus\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{userId}}/verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "{{userId}}",
                "verification"
              ]
            },
            "description": "Marks a user profile as approved and records verifier metadata."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Verification approved\", () => pm.expect(json.data.verificationStatus).to.eql('approved'));",
                  "pm.test(\"Verifier metadata present\", () => {",
                  "    pm.expect(json.data).to.have.property('verifiedAt');",
                  "    pm.expect(json.data).to.have.property('verifiedBy');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reject Verification (with reason)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verificationStatus\": \"rejected\",\n  \"rejectionReason\": \"Missing ID proof\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{pendingUserId}}/verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "{{pendingUserId}}",
                "verification"
              ]
            },
            "description": "Rejects a user verification request and stores a rejection reason."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Verification rejected\", () => pm.expect(json.data.verificationStatus).to.eql('rejected'));",
                  "pm.test(\"Reason captured\", () => pm.expect(json.data.rejectionReason).to.exist);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Soft Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Soft deletes a user and suspends access."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"User flagged deleted\", () => pm.expect(json.data.isDeleted).to.eql(true));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [],
  "protocolProfileBehavior": {}
}
